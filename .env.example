# ============================================================
# NONJ BACKEND — mẫu biến môi trường
# Copy thành .env rồi điền giá trị thật. KHÔNG commit .env.
# ============================================================

# ---- App ----
NODE_ENV=production            # production => bật cookie Secure
PORT=3000                      # Railway tự inject, không cần khai

# ---- CORS: origin của FE (nhiều cái thì ngăn bằng dấu phẩy) ----
FE_URL=https://app.nonj.site,http://localhost:3001

# ---- Database (Postgres / Supabase session pooler) ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=
DB_NAME=nonj_db
DB_SSL=false                   # Supabase => true
DB_SYNCHRONIZE=false           # LẦN ĐẦU deploy để true tạo schema, sau đó false

# ---- JWT (2 secret riêng cho access/refresh) ----
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ---- Cloudflare R2 ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=nonj
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# ---- Email (Resend) ----
RESEND_API_KEY=
MAIL_FROM='NONJ <no-reply@nonj.site>'
# RESEND_BASE_URL=               # chỉ khi test local bằng mock server

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Cron dọn dữ liệu xoá mềm (ngày) ----
PURGE_AFTER_DAYS=14
